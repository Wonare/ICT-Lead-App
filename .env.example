# ------------------------------------------------------------------
# ICT Lead Form - Environment Configuration
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to version control.
# ------------------------------------------------------------------

# Server
HOST=127.0.0.1
PORT=3000

# Local persistent database (no database installation required)
DB_DRIVER=sqlite
# SQLITE_PATH=data/ict-leads.sqlite
# Set DB_DRIVER=mysql to use the MySQL settings below.
NODE_ENV=development

# MySQL database connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ictuser
DB_PASSWORD=your-database-password
DB_NAME=ict_leads

# Authentication (JWT)
# Generate a strong secret, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Default admin account
# Created automatically by `npm run setup` only if no admin exists yet.
# Change this password immediately after first login in production.
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Administrator
ADMIN_DEFAULT_PASSWORD=Admin@12345

# Rate limiting (requests allowed per 15-minute window per IP)
LEAD_RATE_LIMIT=30
LOGIN_RATE_LIMIT=20

# Framing protection (CSP frame-ancestors)
# Leave UNSET in production - nothing should be able to embed the form or
# admin panel in an iframe. Set to * ONLY for local preview panes/dev proxies
# that render the app inside an iframe.
# FRAME_ANCESTORS=*

# Hosted PostgreSQL (Render + Neon)
# Set DB_DRIVER=postgres, NODE_ENV=production, HOST=0.0.0.0, TRUST_PROXY=1
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Set a unique ADMIN_DEFAULT_PASSWORD (12+ characters) and random JWT_SECRET.
