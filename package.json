{
  "name": "ict-lead-form",
  "version": "1.0.0",
  "description": "ICT lead registration form with a protected admin panel and SQLite, PostgreSQL or MySQL storage.",
  "main": "server/server.js",
  "scripts": {
    "setup": "node server/database/init.js",
    "start": "node server/server.js",
    "demo": "node demo-server.js",
    "dev": "node --watch server/server.js",
    "test:form": "node tests/form.e2e.js",
    "test:admin": "node tests/admin.e2e.js",
    "test:storage": "node tests/storage.js",
    "test:export": "node tests/export.js",
    "start:cloud": "node server/database/init.js && node server/server.js",
    "test:postgres": "node tests/postgres.e2e.js"
  },
  "keywords": [
    "ict",
    "lead-form",
    "express",
    "mysql",
    "admin-panel"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@neon/config": "^1.5.1",
    "@neon/env": "^1.3.5",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "jsdom": "^24.1.3"
  }
}
